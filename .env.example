# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Leave everything below unset and the app boots on the seeded in-memory driver:
#   npm run dev   ->   a populated dashboard, no database required.
#
# Set DATABASE_URL (or DATA_DRIVER=postgres) to talk to a real Postgres.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_dashboard

# Force a driver regardless of DATABASE_URL: "postgres" or "memory".
# DATA_DRIVER=memory

# Connection pool tuning (defaults shown).
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Delivery-risk brief
# ---------------------------------------------------------------------------
# With no key the brief is written by the deterministic local model. Set a key
# and Claude writes the narrative instead - the score stays locally computed.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# In-process TTL for the /api/analytics aggregate. 0 disables the cache.
# ANALYTICS_CACHE_TTL_MS=10000
