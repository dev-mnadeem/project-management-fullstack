{
  "name": "project-management-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-query": "^5.107.1",
    "chart.js": "^4.6.1",
    "lucide-react": "^0.487.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "description": "Project and task dashboard with per-project delivery-risk briefs."
}
